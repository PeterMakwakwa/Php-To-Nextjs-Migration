# Copy to .env.local to override. Every value has a sensible default for local development.

# Where the legacy PHP app runs (API + legacy HTML pages).
LEGACY_ORIGIN=http://localhost:8000

# Give up on the legacy API after this many milliseconds and show the error state.
LEGACY_TIMEOUT_MS=5000

# JSON file listing the article slugs Next.js serves. Edits apply on the next request, no restart needed.
MIGRATION_FILE=migration.json

# Public origin of this app, used for canonical URLs and Open Graph tags.
SITE_URL=http://localhost:3000

# Enables POST /api/revalidate (legacy calls it after content changes). Leave unset to disable the endpoint.
# Use a long random value in production; legacy-php/bin/notify-next.php must use the same value.
# REVALIDATE_SECRET=local-demo-secret-123

# Server-side logging: lowest level written (debug | info | warn | error | silent) and output format
# (pretty | json). When LOG_FORMAT is unset: json in production (`next start`), pretty otherwise.
LOG_LEVEL=info
# LOG_FORMAT=json
